---
// Email signup for farm updates. Posts to the farm API (apps/farm-api), served at /api on this
// domain. Works without JavaScript: the browser posts the form and lands on /subscribed. With
// JavaScript, the script below posts it in place and shows the result here instead.
interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Get farm updates",
  text = "Where we're selling, what's at the market this week, and news from the farm. Unsubscribe any time.",
} = Astro.props;
---

<aside class="signup" id="signup">
  <div class="copy">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <form method="post" action="/api/subscribe" data-email-signup>
    <input type="hidden" name="source" value={Astro.url.pathname} />
    <!-- Honeypot: hidden from people and screen readers, so only bots fill it in. -->
    <div class="hp" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="row">
      <label class="sr-only" for="signup-email">Email address</label>
      <input
        id="signup-email"
        type="email"
        name="email"
        required
        maxlength="254"
        autocomplete="email"
        placeholder="you@example.com"
      />
      <button class="btn" type="submit">Sign me up</button>
    </div>
    <p class="status" role="status" aria-live="polite"></p>
  </form>
</aside>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-email-signup]")) {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = "Signing you up…";
      status.dataset.state = "";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error ?? "Something went wrong. Please try again.");
        form.reset();
        status.textContent = data.message ?? "Thanks! You're on the list.";
        status.dataset.state = "ok";
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : String(err);
        status.dataset.state = "error";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .signup {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
  }
  .copy { flex: 1 1 320px; min-width: 0; max-width: 60ch; }
  .copy h2 { font-size: var(--text-xl); }
  .copy p { margin: 0; color: var(--color-text-muted); }

  form { flex: 1 1 360px; min-width: 0; max-width: 520px; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  input[type="email"] {
    flex: 1 1 220px;
    min-width: 0;
    padding: 0.7em 1.1em;
    font: inherit;
    color: var(--color-text);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 999px;
  }
  input[type="email"]:focus-visible {
    outline: none;
    border-color: var(--color-primary);
  }
  .btn { font-size: var(--text-base); cursor: pointer; }
  .btn:disabled { opacity: 0.6; cursor: progress; transform: none; }

  .status { min-height: 1.6em; margin: var(--space-2) 0 0 var(--space-3); font-size: var(--text-sm); }
  .status[data-state="ok"] { color: var(--color-primary); font-weight: 600; }
  .status[data-state="error"] { color: var(--color-accent); }

  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
