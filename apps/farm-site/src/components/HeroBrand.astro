---
/*
  Large logo + farm name for the landing-page hero. As the visitor scrolls it
  shrinks and glides into the header bar, then cross-fades into the header's
  own (single-line) brand link.
  Without JavaScript it simply stays put and the header brand shows as usual.
  Desktop only: on phones it's hidden and the header brand shows as usual.
*/
import { site } from "@/site.config";

// Two lines: everything before the last word, then the last word ("Thistledown" / "Farm")
const split = site.name.lastIndexOf(" ");
const lines = split > 0 ? [site.name.slice(0, split), site.name.slice(split + 1)] : [site.name];
---

<a class="hero-brand" href="/" data-hero-brand aria-label={site.name}>
  <span class="logo" aria-hidden="true"></span>
  <span class="name" aria-hidden="true">{lines.map((line) => <span>{line}</span>)}</span>
</a>

<script>
  const brand = document.querySelector<HTMLElement>("[data-hero-brand]");
  const target = document.querySelector<HTMLElement>("[data-header-brand]");
  // Desktop only — matches the breakpoint in the styles below
  const desktop = window.matchMedia("(min-width: 721px)");

  if (brand && target) {
    // Resting spot in the hero (page coordinates) and docked spot in the header (viewport coordinates)
    let start = { x: 0, y: 0, height: 1 };
    let end = { x: 0, y: 0, height: 1 };

    const update = () => {
      if (!desktop.matches) return;
      const travel = Math.max(start.y - end.y, 1);
      const p = Math.min(Math.max(window.scrollY / travel, 0), 1);
      // Scrolls up with the page until it reaches the header, then holds there
      const dy = Math.max(window.scrollY - travel, 0);
      const dx = (end.x - start.x) * p;
      // Shrink until the logo matches the header logo's height
      const scale = 1 + (end.height / start.height - 1) * p;
      brand.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
      brand.style.setProperty("--p", String(p));
      // Over the last stretch, swap to the header's single-line brand
      const fade = Math.min(Math.max((p - 0.8) / 0.2, 0), 1);
      brand.style.opacity = String(1 - fade);
      brand.style.pointerEvents = fade === 1 ? "none" : "";
      document.documentElement.style.setProperty("--brand-dock", String(fade));
    };

    const measure = () => {
      document.documentElement.classList.toggle("brand-docking", desktop.matches);
      brand.style.transform = "";
      brand.style.removeProperty("--p");
      brand.style.opacity = "";
      brand.style.pointerEvents = "";
      if (!desktop.matches) return;
      const b = brand.getBoundingClientRect();
      const t = target.getBoundingClientRect();
      start = { x: b.left, y: b.top + window.scrollY, height: b.height };
      end = { x: t.left, y: t.top, height: t.height };
      update();
    };

    let frame = 0;
    const onScroll = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", measure);
    document.fonts?.ready.then(measure);
    measure();
  }
</script>

<style>
  .hero-brand {
    --p: 0;
    position: relative;
    z-index: 11; /* above the sticky header while docking */
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-weight: 700;
    /* The largest text in the hero */
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    white-space: nowrap;
    text-decoration: none;
    transform-origin: top left;
    will-change: transform, opacity;
    /* Cream over the photo, fading to the header's text colour as it docks */
    color: color-mix(in srgb, var(--color-text) calc(var(--p) * 100%), #fbf3e6);
    text-shadow: 0 1px 12px rgb(0 0 0 / calc(0.35 * (1 - var(--p))));
  }
  .hero-brand:hover { color: color-mix(in srgb, var(--color-text) calc(var(--p) * 100%), #fbf3e6); }
  .name {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  /* Logo spans both lines of the name */
  .logo {
    height: 2em;
    aspect-ratio: 175 / 192;
    flex-shrink: 0;
    background: currentColor;
    -webkit-mask: url("/images/logo-mark.png") center / contain no-repeat;
    mask: url("/images/logo-mark.png") center / contain no-repeat;
  }

  /* Phones keep the normal header brand */
  @media (max-width: 720px) {
    .hero-brand { display: none; }
  }
</style>
