---
/*
  Large logo + farm name for the landing-page hero. Desktop only — on phones
  it's hidden and the header's TDF wordmark is enough.
*/
import { site } from "@/site.config";

// Two lines: everything before the last word, then the last word ("Thistledown" / "Farm")
const split = site.name.lastIndexOf(" ");
const lines = split > 0 ? [site.name.slice(0, split), site.name.slice(split + 1)] : [site.name];
---

<a class="hero-brand" href="/" aria-label={site.name}>
  <span class="logo" aria-hidden="true"></span>
  <span class="name" aria-hidden="true">{lines.map((line) => <span>{line}</span>)}</span>
</a>

<style>
  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-bottom: var(--space-4);
    font-family: var(--font-brand);
    font-weight: 700;
    font-style: italic;
    /* The largest text in the hero */
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    white-space: nowrap;
    text-decoration: none;
    /* Cream over the dark photo overlay in both themes */
    color: #fbf3e6;
  }
  .hero-brand:hover { color: #fbf3e6; }
  .name {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  /* Logo spans both lines of the name */
  .logo {
    height: 2em;
    aspect-ratio: 175 / 192;
    flex-shrink: 0;
    background: currentColor;
    -webkit-mask: url("/images/logo-mark.png") center / contain no-repeat;
    mask: url("/images/logo-mark.png") center / contain no-repeat;
  }

  /* Phones keep the normal header brand */
  @media (max-width: 720px) {
    .hero-brand { display: none; }
  }
</style>
