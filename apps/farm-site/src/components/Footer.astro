---
import { site, nav } from "@/site.config";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <a class="logo" href="/"><span class="visually-hidden">{site.name}</span></a>
      <p>{site.location}</p>
      {site.certifications.map((c) => <p class="cert">{c}</p>)}
    </div>
    <nav aria-label="Footer">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {site.instagram && <p><a href={site.instagram}>Instagram</a></p>}
    </div>
  </div>
  <div class="container legal">© {year} {site.name}</div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .cols {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  /* Logo is used as a mask so the ink follows the theme's text color */
  .logo {
    display: block;
    width: 180px;
    aspect-ratio: 480 / 438;
    margin-bottom: var(--space-3);
    background: var(--color-text);
    -webkit-mask: url("/images/logo-full.png") center / contain no-repeat;
    mask: url("/images/logo-full.png") center / contain no-repeat;
  }
  .cert {
    display: inline-block;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15em 0.8em;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: var(--space-1); }
  .legal { margin-top: var(--space-4); }
</style>
