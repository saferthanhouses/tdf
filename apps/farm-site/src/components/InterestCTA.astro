---
// "Keep me posted" band for things we're still planning. Opens an email to the
// farm with a subject line, so there's no form service to set up.
import { site } from "@/site.config";

interface Props {
  title: string;
  text: string;
  subject: string;
  button?: string;
}
const { title, text, subject, button = "Keep me posted" } = Astro.props;
const href = `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<aside class="interest">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="btn" href={href}>{button}</a>
</aside>

<style>
  .interest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
  }
  .interest > div { max-width: 60ch; }
  .interest h2 { font-size: var(--text-xl); }
  .interest p { margin: 0; color: var(--color-text-muted); }
</style>
