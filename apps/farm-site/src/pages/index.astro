---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCard from "@/components/ProductCard.astro";
import MarketSchedule from "@/components/MarketSchedule.astro";
import HeroCarousel from "@/components/HeroCarousel.astro";
import PillarCards from "@/components/PillarCards.astro";
import InterestCTA from "@/components/InterestCTA.astro";
import { getCollection } from "astro:content";
import { site } from "@/site.config";

const featured = (await getCollection("products", (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout>
  <HeroCarousel />

  <section class="section">
    <div class="container">
      <header class="intro">
        <p class="eyebrow">{site.location}</p>
        <h1>{site.tagline}</h1>
        <p class="lede">
		Situated on patch of rugged hillside in the Catskills mountains, we are a small family farm with a simple mission: raise the food that we love, in the place that we love and share it with the people we love. </p>
		<p>We are market farm - we raise and cook food to sell at markets in New York City. We are a community farm - we run events to give back to our local community. We are a place to </p>
        <div class="actions">
			<a class="btn" href="/food">Food From The Farm</a>
			<a class="btn btn--ghost" href="#updates">Hear about Events & Farm Stays</a>
        </div>
      </header>
      <PillarCards />
    </div>
  </section>
  <section class="market-band">
    <div class="container">
      <div class="head-row">
        <h2>Where to find us</h2>
        <a href="/markets">Market details →</a>
      </div>
      <MarketSchedule compact />
    </div>
  </section>

  <section class="section" id="updates">
    <div class="container">
      <InterestCTA
        title="Be the first to hear about Farm Stays & Events"
        text="Farm-To-Table Workshops, movie nights under the stars and farm stays are still taking shape. Send us a note and we'll let you know when the first dates open — and tell us what you'd love to see."
        subject="Keep me posted on Farm Stays & Events"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .intro { max-width: 820px; margin-bottom: var(--space-6); }
  .intro h1 { font-size: var(--text-hero); font-weight: 700; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .head-row h2 { margin: 0; }

  /* "Where to find us": a big full-width barn-red section with gold rules top and bottom */
  .market-band {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 56svh;
    padding-block: var(--space-5);
    background: var(--color-feature);
    color: var(--color-feature-text);
    border-block: 8px solid var(--color-highlight);
    box-shadow:
      inset 0 18px 36px -22px rgb(0 0 0 / 0.55),
      inset 0 -18px 36px -22px rgb(0 0 0 / 0.55),
	  0 14px 36px -14px rgb(60 20 10 / 0.45);
    border-radius: 0;
  }
  /* Thin inner rule, like the trim on a barn door */
  .market-band::before {
    content: "";
    position: absolute;
    inset: 12px 0;
    border-block: 1px solid rgb(251 243 230 / 0.35);
    pointer-events: none;
  }
  .market-band .head-row { margin-bottom: var(--space-4); }
  .market-band h2 {
    color: var(--color-feature-text);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 700;
  }
  .market-band .head-row a { color: #f3cd7a; font-weight: 600; font-size: var(--text-lg); }
  .market-band .head-row a:hover { color: var(--color-feature-text); }

  /* Next-market chip with a big pre-order button */
  .market-band :global(.next:not([hidden])) {
    font-size: var(--text-lg);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    margin-bottom: var(--space-4);
    box-shadow: 0 10px 28px rgb(30 8 4 / 0.35);
  }
  .market-band :global(.next-cta) {
    font-size: var(--text-lg);
    padding: 0.65em 1.5em;
    background: var(--color-feature);
    border-color: var(--color-feature);
    color: var(--color-feature-text);
  }
  .market-band :global(.next-cta:hover) { color: var(--color-feature-text); background: #6e2318; }

  /* Bigger, clickable market cards */
  .market-band :global(.list) { gap: var(--space-4); }
  .market-band :global(.market) {
    color: var(--color-text);
    border-color: transparent;
    box-shadow: 0 12px 32px rgb(30 8 4 / 0.35);
  }
  .market-band :global(.market.linked:hover) { box-shadow: 0 18px 40px rgb(30 8 4 / 0.45); }
  .market-band :global(.market h3) { font-size: var(--text-xl); }
  .market-band :global(.market .when) { font-size: var(--text-lg); }
  .market-band :global(.market .where) { font-size: var(--text-base); }
  .market-band :global(.market-cta) {
    background: var(--color-feature);
    border-color: var(--color-feature);
    color: var(--color-feature-text);
  }
  .market-band :global(.market-cta:hover) { color: var(--color-feature-text); background: #6e2318; }

  @media (max-width: 720px) {
    .market-band { min-height: 0; }
    .market-band :global(.next:not([hidden])) {
      border-radius: var(--radius-lg);
      padding: var(--space-3);
    }
  }
</style>
