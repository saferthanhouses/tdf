# Copy to /etc/pg-ops.env on each database Droplet (chmod 600, owned by root).
# provision.sh, refresh-test-db.sh and check-backup-freshness.sh all read it.

# prod | test
DB_ROLE=prod
PG_VERSION=18
DB_NAME=barnbooks

# Private network allowed to connect (DO VPC range), and the admin user that replaces root SSH login.
VPC_CIDR=10.10.0.0/16
ADMIN_USER=joe

# Block Storage Volume for the data directory. Leave empty to keep data on the Droplet disk.
# DO volumes appear as /dev/disk/by-id/scsi-0DO_Volume_<volume-name>.
DATA_DEVICE=/dev/disk/by-id/scsi-0DO_Volume_pg-data

# pgBackRest repository on DO Spaces (use a bucket in a different region from the Droplet).
SPACES_ENDPOINT=fra1.digitaloceanspaces.com
SPACES_BUCKET=tdf-pg-backups
SPACES_REPO_PATH=/prod
# prod: a key that can write. test: a separate read-only key scoped to the bucket.
SPACES_KEY=
SPACES_SECRET=
# Encrypts the repository. Same value on prod and test; also keep it in your password manager.
PGBACKREST_CIPHER_PASS=

# Database role passwords. Use different values on test so a test app can never log in to prod.
OWNER_PASSWORD=
APP_PASSWORD=
READONLY_PASSWORD=

# Healthchecks.io ping URLs (optional but recommended).
# prod: pinged by check-backup-freshness.sh. test: pinged by refresh-test-db.sh.
HC_BACKUP_URL=
HC_REFRESH_URL=

# Freshness thresholds (check-backup-freshness.sh). Diffs run daily and fulls weekly.
MAX_BACKUP_AGE_HOURS=26
MAX_FULL_AGE_HOURS=192
