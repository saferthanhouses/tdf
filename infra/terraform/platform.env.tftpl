# Generated by infra/terraform (tofu apply). Edit variables there, not this file.
# Installed on the Droplet as /opt/platform/.env by bootstrap.sh. Keys match
# infra/platform/platform.env.example.

# --- Host
ADMIN_USER=${admin_user}
REPO_URL=${repo_url}
REPO_BRANCH=${repo_branch}
TS_AUTHKEY_HOST=${ts_authkey_host}
%{ for app in apps ~}
TS_AUTHKEY_${upper(app)}=${lookup(ts_authkey_apps, app, "")}
%{ endfor ~}
COMPOSE_PROFILES=tailscale

# --- Postgres
DATA_DEVICE=/dev/disk/by-id/scsi-0DO_Volume_${volume_name}
PGDATA_DIR=/mnt/pgdata
STATE_DIR=/opt/platform/state
DB_MEM_LIMIT=${db_mem_limit}
POSTGRES_SUPERUSER_PASSWORD=${superuser_password}
APP_DATABASES="${join(" ", apps)}"
%{ for app in apps ~}
${upper(app)}_OWNER_PASSWORD=${app_passwords["${app}_owner"]}
${upper(app)}_APP_PASSWORD=${app_passwords["${app}_app"]}
${upper(app)}_READONLY_PASSWORD=${app_passwords["${app}_readonly"]}
%{ endfor ~}

# --- Backups
SPACES_ENDPOINT=${spaces_endpoint}
SPACES_BUCKET=${spaces_bucket}
SPACES_REPO_PATH=${spaces_repo_path}
SPACES_KEY=${spaces_key}
SPACES_SECRET=${spaces_secret}
PGBACKREST_CIPHER_PASS=${cipher_pass}
HC_BACKUP_URL=${hc_backup_url}
MAX_BACKUP_AGE_HOURS=26
MAX_FULL_AGE_HOURS=192

# --- Public sites
FARM_SITE_DOMAIN=${farm_site_domain}
ACME_EMAIL=${acme_email}
