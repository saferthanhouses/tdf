# Platform Droplet settings. Copy to /opt/platform/.env (chmod 600, owned by root).
# Read by provision.sh, deploy.sh, create-app-db.sh, check-backup-freshness.sh and, through the
# platform-compose wrapper, by compose.yaml.

# --- Host -------------------------------------------------------------------------------------
# The admin user that replaces root SSH login.
ADMIN_USER=joe
# Repository the Droplet deploys from (read-only deploy key) and the branch it tracks.
REPO_URL=git@github.com:saferthanhouses/tdf.git
REPO_BRANCH=main
# Tailscale: a reusable auth key for the host (SSH over the tailnet) and one per private app.
TS_AUTHKEY_HOST=
TS_AUTHKEY_BARNBOOKS=
# Profiles started by deploy.sh. Keep "tailscale" so private apps get their sidecars.
COMPOSE_PROFILES=tailscale

# --- Postgres ---------------------------------------------------------------------------------
# Block Storage Volume for the data directory (/dev/disk/by-id/scsi-0DO_Volume_<name>), mounted at
# PGDATA_DIR. Leave DATA_DEVICE empty to keep data on the Droplet's own disk.
DATA_DEVICE=/dev/disk/by-id/scsi-0DO_Volume_pg-data
PGDATA_DIR=/mnt/pgdata
STATE_DIR=/opt/platform/state
DB_MEM_LIMIT=1g
# Only used when the data directory is first created; the superuser can't log in over the network.
POSTGRES_SUPERUSER_PASSWORD=

# One database per app, each with <app>_owner (migrations), <app>_app (the app) and <app>_readonly.
# Passwords: <APP>_OWNER_PASSWORD, <APP>_APP_PASSWORD, <APP>_READONLY_PASSWORD
# (16+ characters of A-Za-z0-9_.~+=-, e.g. openssl rand -hex 32).
APP_DATABASES="barnbooks"
BARNBOOKS_OWNER_PASSWORD=
BARNBOOKS_APP_PASSWORD=
BARNBOOKS_READONLY_PASSWORD=

# --- Backups (pgBackRest -> DO Spaces, in a different region from the Droplet) ------------------
SPACES_ENDPOINT=fra1.digitaloceanspaces.com
SPACES_BUCKET=tdf-pg-backups
SPACES_REPO_PATH=/platform
# Read/write key scoped to the backup bucket.
SPACES_KEY=
SPACES_SECRET=
# Encrypts the repository. Also store it in your password manager: backups are useless without it.
PGBACKREST_CIPHER_PASS=

# Healthchecks.io ping URL for check-backup-freshness.sh (period 1h, grace 2h).
HC_BACKUP_URL=
MAX_BACKUP_AGE_HOURS=26
MAX_FULL_AGE_HOURS=192

# --- Public sites -----------------------------------------------------------------------------
FARM_SITE_DOMAIN=example.com
ACME_EMAIL=
