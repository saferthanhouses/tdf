# Public edge. Private apps are not listed here: they are served only over Tailscale.
{
	email {$ACME_EMAIL}
}

{$FARM_SITE_DOMAIN} {
	encode zstd gzip
	# The site's forms (email signup) post here, on the same domain, so no CORS.
	handle /api/* {
		reverse_proxy farm-api:3002
	}
	handle {
		reverse_proxy farm-site:80
	}
}
