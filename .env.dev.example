# Local development settings. Copy to .env.dev (gitignored): cp .env.dev.example .env.dev
# The root npm scripts load it with dotenvx. Values match the dev Postgres in infra/compose.yaml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mysecurepassword
DB_NAME=mydatabase
DB_SSLMODE=disable
